  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "HTTP Performance & Golden Signals (RED)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 2,
      "title": "HTTP Request Rate (by Service)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (service)",
          "legendFormat": "{{ service }}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 3,
      "title": "HTTP 5xx Error Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status_code=~\"5..\"}[1m])) by (service) / sum(rate(http_requests_total[1m])) by (service)",
          "legendFormat": "{{ service }} 5xx %"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 4,
      "title": "Average Request Latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(http_request_duration_seconds_sum[1m]) / rate(http_request_duration_seconds_count[1m])",
          "legendFormat": "{{ service }} - {{ route }}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 5,
      "title": "Event Streaming, Outbox & Dead Letter Queue (DLQ)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "id": 6,
      "title": "Transactional Outbox Backlog (Gauge)",
      "type": "stat",
      "targets": [
        {
          "expr": "outbox_unpublished_events_total",
          "legendFormat": "Unpublished Outbox Events"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
      "id": 7,
      "title": "Kafka Event Throughput (Publish vs Consume)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(kafka_events_published_total[1m])) by (service)",
          "legendFormat": "Published: {{ service }}"
        },
        {
          "expr": "sum(rate(kafka_events_consumed_total[1m])) by (service)",
          "legendFormat": "Consumed: {{ service }}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "id": 8,
      "title": "DLQ Poison Pills & Failures Total",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(dlq_messages_total) by (service, error_type)",
          "legendFormat": "{{ service }}: {{ error_type }}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 9,
      "title": "Infrastructure & PostgreSQL Connection Pool",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "id": 10,
      "title": "PostgreSQL Connection Pool Status",
      "type": "timeseries",
      "targets": [
        {
          "expr": "pg_pool_active_connections",
          "legendFormat": "Active ({{ service }})"
        },
        {
          "expr": "pg_pool_idle_connections",
          "legendFormat": "Idle ({{ service }})"
        },
        {
          "expr": "pg_pool_waiting_clients",
          "legendFormat": "Waiting ({{ service }})"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "id": 11,
      "title": "Node.js Heap Memory Used",
      "type": "timeseries",
      "targets": [
        {
          "expr": "nodejs_memory_heap_used_bytes",
          "legendFormat": "{{ service }}"
        }
      ]
    }
  ],
